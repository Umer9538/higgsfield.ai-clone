# Firestore via firebase-admin. Server-side secrets: no NEXT_PUBLIC_ prefix, so
# they are never shipped to the browser.
#
# Where to get them: Firebase console -> Project settings -> Service accounts ->
# Generate new private key. That downloads a JSON file; copy three fields out.
#
# All optional. With any of them unset, /api/generations and /api/favorites fall
# back to an in-memory store, so the app, the build and the tests run without
# credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key including the BEGIN/END lines. Keep the literal \n
# sequences on one line; lib/firebase-admin.ts converts them back to newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
