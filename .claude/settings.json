{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-capture.py\"",
            "timeout": 30,
            "statusMessage": "Capturing prompt..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-capture.py\"",
            "timeout": 30,
            "statusMessage": "Capturing response..."
          }
        ]
      }
    ]
  }
}
